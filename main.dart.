
import 'package:flutter/material.dart';

void main() {
  runApp(const TwinkleApp());
}

class TwinkleApp extends StatelessWidget {
  const TwinkleApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Twinkle',
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: const Color(0xFF101827),
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFFD99A78),
          brightness: Brightness.dark,
        ),
      ),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Twinkle ✨',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: const Color(0xFF101827),
      ),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Olá! Bem-vinda ao Twinkle',
              style: TextStyle(
                fontSize: 23,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 8),
            const Text(
              'Organize suas campanhas em um só lugar.',
              style: TextStyle(color: Colors.white70),
            ),
            const SizedBox(height: 25),
            _menuCard(
              icon: Icons.campaign_outlined,
              title: 'Minhas campanhas',
              subtitle: 'Organize e acompanhe suas campanhas',
            ),
            _menuCard(
              icon: Icons.groups_outlined,
              title: 'Públicos e contatos',
              subtitle: 'Gerencie contatos com autorização',
            ),
            _menuCard(
              icon: Icons.bar_chart,
              title: 'Relatórios',
              subtitle: 'Acompanhe os resultados',
            ),
            _menuCard(
              icon: Icons.settings_outlined,
              title: 'Configurações',
              subtitle: 'Personalize seu aplicativo',
            ),
          ],
        ),
      ),
    );
  }

  Widget _menuCard({
    required IconData icon,
    required String title,
    required String subtitle,
  }) {
    return Card(
      color: const Color(0xFF202C3D),
      margin: const EdgeInsets.only(bottom: 13),
      child: ListTile(
        leading: Icon(icon, color: const Color(0xFFE5AD8D)),
        title: Text(title),
        subtitle: Text(subtitle),
        trailing: const Icon(Icons.chevron_right),
      ),
    );
  }
}
